{
    "name": "sevk/sevk-php",
    "description": "PHP SDK for Sevk API",
    "type": "library",
    "license": "MIT",
    "keywords": ["sevk", "email", "api", "sdk"],
    "homepage": "https://sevk.io",
    "authors": [
        {
            "name": "Sevk",
            "email": "dev@sevk.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.15.2",
        "scrivo/highlight.php": "^9.18"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Sevk\\": "src/"
        },
        "files": [
            "src/Markup/render-function.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sevk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.gitignore",
            "/.phpunit.cache",
            "/composer.lock",
            "/phpstan.neon",
            "/phpunit.xml",
            "/tests",
            "/vendor"
        ]
    }
}
